    usecase "Cadastrar Conta" as UC1

    usecase "Buscar Instrutores" as UC2
    usecase "Filtrar Instrutores" as UC3
    usecase "Visualizar Perfil do Instrutor" as UC4

    usecase "Agendar Aula" as UC5
    usecase "Visualizar Agendamentos" as UC6

    usecase "Avaliar Instrutor" as UC7

    usecase "Gerenciar Perfil" as UC8
    usecase "Gerenciar Disponibilidade" as UC9

    usecase "Receber Solicitação de Aula" as UC10
